# ==========================================
# EarnCashIO Environment Configuration (.env)
# ==========================================

# Server Port
PORT=5000
NODE_ENV=development

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Frontend URL (for CORS and Mini App redirects)
CLIENT_URL=http://localhost:5173

# Admin Telegram IDs (Comma-separated list of Telegram User IDs)
# e.g., 123456789,987654321
ADMIN_TELEGRAM_IDS=

# Database Connection (Supabase / Neon PostgreSQL / SQLite)
# Example PostgreSQL: postgresql://postgres:password@db.supabase.co:5432/postgres
# Example Local SQLite (default for development): sqlite:./data/earncashio.db
DATABASE_URL=sqlite:./data/earncashio.db

# Adsgram Ad Network Block IDs
# Test Block ID: "int-test" or "rew-test" for development
ADSGRAM_BLOCK_ID=rew-test

# Secret for session signing / tokens
JWT_SECRET=your_super_secret_jwt_key_change_in_production
